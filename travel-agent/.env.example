# Travel Concierge — voice agent keys. Copy to .env (already gitignored) and
# fill in only what you want to use. With nothing set, the voice agent uses
# the browser's free Web Speech API and nothing here is needed.
# Full setup steps + free-tier notes: VOICE.md

# --- Speech-to-text (pick one; Deepgram preferred) -------------------------
# Deepgram: $200 free credit on signup, no card. Also covers text-to-speech.
DEEPGRAM_API_KEY=
# Groq: free tier (Whisper, ~2,000 requests/day). STT only.
GROQ_API_KEY=

# --- Text-to-speech (Deepgram key above covers this; ElevenLabs optional) --
# ElevenLabs: free plan ~10,000 credits/month, premade voices, API access.
ELEVENLABS_API_KEY=

# --- Understanding spoken answers (Claude) ---------------------------------
# platform.claude.com → API keys. New accounts get a small starter credit;
# each answer is a tiny request, a whole demo costs well under $0.10.
ANTHROPIC_API_KEY=

# --- Optional overrides ----------------------------------------------------
# auto (default) picks the first provider with a key; or: deepgram | groq
VOICE_STT_PROVIDER=auto
# auto (default) | deepgram | elevenlabs
VOICE_TTS_PROVIDER=auto
# set to "none" to skip Claude and use the page's local regex parsers
VOICE_LLM_PROVIDER=auto
# Deepgram/Groq language hint
VOICE_LANGUAGE=en
# Deepgram models/voices — see https://developers.deepgram.com/docs/models
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
# Groq Whisper model
GROQ_STT_MODEL=whisper-large-v3-turbo
# ElevenLabs premade voice id + model
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- WhatsApp channel (Meta WhatsApp Cloud API) -----------------------------
# Setup steps: WHATSAPP.md. All three are required to enable the webhook.
# Permanent or temporary access token from Meta for Developers → WhatsApp → API Setup
WHATSAPP_TOKEN=
# "Phone number ID" (not the phone number itself) from the same page
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; paste the same value in the webhook config
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings → Basic) — enables X-Hub-Signature-256 checks. Set it for anything public.
WHATSAPP_APP_SECRET=
# Graph API version for sends
WHATSAPP_GRAPH_VERSION=v21.0
# Public https URL of this server (e.g. your ngrok URL) — used for links in messages
PUBLIC_BASE_URL=
# webcmd profile used for live searches started from WhatsApp
WEBCMD_PROFILE=travel-agent
